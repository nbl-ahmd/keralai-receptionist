# ─────────────────────────────────────────────────────────────────────────────
# KeralaI Bridge — environment template
#
# Copy to .env for production on Render, or .env.local for local dev.
# NEVER commit real secrets.
#
# On Render: set secrets (DATABASE_URL, GEMINI_API_KEY, etc.) via the
# dashboard "Environment" tab — do NOT put them in render.yaml.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# REQUIRED.
# Use the POOLED (PgBouncer) connection string from the Neon console, NOT the
# direct endpoint. The pooled endpoint goes through PgBouncer and multiplexes
# the bridge's pg Pool connections, respecting Neon's per-project limits.
#
# In the Neon console: Connection Details → "Pooled connection" toggle ON.
# Format: postgresql://<role>:<password>@<ep-xxx-pooler.region.neon.tech>/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.neon.tech/db?sslmode=require

# Optional: Postgres pool max connections (default 10).
# PG_POOL_MAX=10

# Optional: per-query timeout in ms (default 15000). Applied as both the
# server-side statement_timeout and the client-side query_timeout so a slow
# query can never exhaust the pool.
# PG_QUERY_TIMEOUT_MS=15000

# ─── Gemini (server-side) ────────────────────────────────────────────────────
# REQUIRED.
# The bridge, embeddings, and knowledge search all use this key.
# Get one at https://aistudio.google.com/app/apikey
# NEVER use NEXT_PUBLIC_GOOGLE_API_KEY here — that key is exposed in the browser.
GEMINI_API_KEY=your_server_side_gemini_key_here

# Optional: override the Gemini Live model (default gemini-3.8-live) and the
# embedding model used for knowledge-base search (default gemini-embedding-2).
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional: per-request embedding timeout in ms (default 8000).
# EMBED_TIMEOUT_MS=8000

# ─── HTTP port ───────────────────────────────────────────────────────────────
# Render injects PORT automatically. Do NOT set this manually on Render.
# For local development only:
# PORT=3001

# ─── Phone bridge (Exotel) ───────────────────────────────────────────────────
# Exotel sends 8 kHz by default. Set 16000 only if your applet is configured
# with ?sample-rate=16000.
# EXOTEL_SAMPLE_RATE=8000

# Maya voice persona for phone calls.
# Available: Aoede, Kore, Zephyr, Puck, Fenrir, Charon
# MAYA_VOICE=Aoede

# Speaking style hints injected into the system instruction.
# MAYA_PITCH=Normal     # Low | Normal | High
# MAYA_SPEED=Normal     # Slow | Normal | Fast

# How often (ms) the bridge checks whether the company profile has changed.
# Default: 300000 (5 minutes). Set lower in dev to pick up changes faster.
# PROFILE_CACHE_TTL_MS=300000

# ─── Browser relay ───────────────────────────────────────────────────────────
# Optional origin check for /ws/browser connections.
# Set this to your Vercel app's production URL to prevent unauthorised use.
# PUBLIC_APP_ORIGIN=https://your-app.vercel.app

# Optional abuse controls.
# BROWSER_MAX_SESSIONS_PER_IP=3
# BROWSER_SESSION_TTL_MS=900000   # 15 minutes

# ─── CRM integration ─────────────────────────────────────────────────────────
# CRM_PROVIDER=none             # none (default) | webhook
# CRM_WEBHOOK_URL=https://your-crm-endpoint.example/hooks/keralai
# CRM_WEBHOOK_SECRET=shared_secret_sent_as_X-KeralAI-Signature
# CRM_TIMEOUT_MS=8000           # webhook request timeout (background; never blocks audio)

# ─── Debugging ───────────────────────────────────────────────────────────────
# Set to "1" to enable per-operation latency logs (DB queries, embed, search,
# Gemini connect). Disable in production to reduce log noise.
# DEBUG_TIMING=1
