# ─────────────────────────────────────────────────────────────────────────────
# KeralAI Bridge — environment template
#
# Copy to bridge/.env.local for local development (from the app root).
# Render production uses dashboard environment variables, not a checked-in env file.
# NEVER commit real secrets.
#
# On Render: set secrets (DATABASE_URL, BRIDGE_AUTH_SECRET,
# TENANT_SECRETS_ENCRYPTION_KEY) via the dashboard "Environment" tab — do NOT
# put them in render.yaml.
#
# The bridge is tenant-aware. It validates signed Vobiz DID claims (legacy Exotel URL tokens remain supported)
# before touching the database, then uses that tenant's encrypted provider
# credentials, or the explicitly enabled closed-alpha platform Gemini key (see below).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# REQUIRED.
# Use the POOLED (PgBouncer) connection string from the Neon console, NOT the
# direct endpoint. The pooled endpoint goes through PgBouncer and multiplexes
# the bridge's pg Pool connections, respecting Neon's per-project limits.
#
# In the Neon console: Connection Details → "Pooled connection" toggle ON.
# Format: postgresql://<role>:<password>@<ep-xxx-pooler.region.neon.tech>/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.neon.tech/db?sslmode=require

# Optional: Postgres pool max connections (default 10).
# PG_POOL_MAX=10

# Optional: per-query timeout in ms (default 15000).
# PG_QUERY_TIMEOUT_MS=15000

# ─── Shared tenant secrets (MUST match the Next.js app) ──────────────────────
# REQUIRED. Signs and verifies the short-lived browser-voice bridge token.
# If this differs from the dashboard's value, browser voice returns 401.
BRIDGE_AUTH_SECRET=replace_with_a_random_32_byte_base64_secret

# REQUIRED. AES-256-GCM key that decrypts tenant provider credentials (the
# tenant's Gemini key, CRM webhook secret, etc.). Must match the dashboard.
# If it does not, calls connect and then drop immediately: the bridge logs
# "startup db-check: ... undecryptable=[...]" and the tenant credential cannot
# be decrypted. Copy the exact Vercel value here; never regenerate it.
TENANT_SECRETS_ENCRYPTION_KEY=replace_with_a_random_32_byte_base64_key

# ─── Legacy Gemini key import (one-time, optional) ───────────────────────────
# Only for deployments upgrading from the single-tenant version. On startup the
# bridge encrypts this key into the pre-multitenancy "legacy" tenant (once), so
# existing phone calls keep working without re-entering the key. It is never
# used for ordinary tenant traffic. The older name GEMINI_API_KEY is accepted as
# a fallback if this is unset.
# LEGACY_GEMINI_API_KEY=your_google_ai_studio_key

# ─── Gemini model fallbacks ──────────────────────────────────────────────────
# Personal-key mode permits tenant model overrides. Platform alpha mode uses
# these operator-selected defaults and does not accept personal model overrides.
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional: per-request embedding timeout in ms (default 8000).
# EMBED_TIMEOUT_MS=8000

# ─── HTTP port ───────────────────────────────────────────────────────────────
# Render injects PORT automatically. Do NOT set this manually on Render.
# For local development only:
# PORT is set to 3001 below for local use; Render supplies its own PORT.

# ─── Phone bridge (tenant-aware Exotel routing) ──────────────────────────────
# The Exotel Voicebot applet must point at a TENANT-SPECIFIC URL. Prefer the
# Basic-auth form (Exotel forwards it as an Authorization header and does not
# mangle it):
#     wss://tenant:<tenant-token>@<service-name>.onrender.com/ws/exotel/<tenant-slug>
# The query form also works:
#     wss://<service-name>.onrender.com/ws/exotel/<tenant-slug>?token=<tenant-token>
#
# Copy the exact URL from Dashboard → Settings → Providers → Exotel routing.
# The bare path /ws/exotel (no slug) is rejected; there is no default tenant.
# Only a SHA-256 hash of the token is stored server-side.
#
# Fallback sample rate only. The bridge prefers the rate Exotel reports per call
# (start.media_format.sample_rate), then the applet URL's ?sample-rate=.
# EXOTEL_SAMPLE_RATE=8000

# Voice, pitch, speed and the opening greeting are managed per tenant in the
# dashboard and stored in `company_profile`. Values below are fallbacks only.
#
# ASSISTANT_VOICE=Aoede   # Aoede | Kore | Zephyr | Puck | Fenrir | Charon
# ASSISTANT_PITCH=Normal  # Low | Normal | High
# ASSISTANT_SPEED=Normal  # Slow | Normal | Fast
# ASSISTANT_GREETING=0    # 0 disables the server greeting (fallback only)

# Live transcription, vocabulary, and voice-activity tuning.
# Tenant names from the company profile are added to the vocabulary automatically.
# GEMINI_TRANSCRIPTION_LANGUAGES=ml-IN,en-IN
# GEMINI_TRANSCRIPTION_CUSTOM_VOCABULARY=KeralAI,Kerala,Kochi
# GEMINI_TRANSCRIPTION_MODE=VERBATIM      # VERBATIM | SMART
# GEMINI_END_SILENCE_MS=350               # end-of-speech silence (lower = faster turns)
# GEMINI_PREFIX_PADDING_MS=200
# END_CALL_GRACE_MS=900                   # delay before hang-up after the caller is done

# How often (ms) the bridge checks whether a tenant profile has changed.
# Default: 300000 (5 minutes).
# PROFILE_CACHE_TTL_MS=300000

# ─── Browser relay ───────────────────────────────────────────────────────────
# Required origin allow-list for /ws/browser connections. Set this to your
# dashboard origin(s) to prevent unauthorised use. Comma-separated for multiple
# (e.g. production + preview URLs). Trailing slashes/casing are ignored.
# Missing, empty or mismatched origins are rejected with 403.
PUBLIC_APP_ORIGIN=http://localhost:3000
# On Render replace with the actual Vercel app origin(s), comma-separated.

# Optional abuse controls.
# BROWSER_MAX_SESSIONS_PER_IP=3
# Session duration is enforced by the database plan (maximum 900 seconds).

# ─── CRM integration (per tenant) ────────────────────────────────────────────
# CRM is configured per tenant in the dashboard; the bridge reads the current
# tenant's provider/webhook URL and decrypts its webhook secret.
# CRM_TIMEOUT_MS=8000           # webhook request timeout (background; never blocks audio)

# Optional: barge-in watchdog. Model audio is muted while an interrupted turn
# finishes; if Gemini never reports turn completion, it is unmuted after this
# many ms so the call can't go permanently silent (default 2000).
# BARGE_IN_MUTE_MS=2000

# ─── Observability / latency ─────────────────────────────────────────────────
# Aggregate [bridge][perf] logs are ON by default. Disable with LATENCY_LOG=0.
#
# LATENCY_LOG=0
# LATENCY_LOG_INTERVAL_MS=30000 # per-call summary interval (0 = only at call end)
# VERBOSE_AUDIO_LOG=1           # log EVERY audio chunk (very noisy; deep debugging)
# SLOW_DB_MS=250                # warn on queries slower than this
#
# GET /metrics returns a JSON snapshot (counters + latency percentiles) for
# benchmarking. Disable with METRICS_ENABLED=0, or protect it with a token.
# METRICS_ENABLED=1
# METRICS_TOKEN=change_me

# ─── Debugging ───────────────────────────────────────────────────────────────
# Set to "1" to enable the older per-phase DEBUG_TIMING logs.
# DEBUG_TIMING=1
# Vobiz media uses /ws/vobiz with a signed short-lived call token.
# The bridge needs no Vobiz parent credentials. App and bridge must share the
# database, BRIDGE_AUTH_SECRET and TENANT_SECRETS_ENCRYPTION_KEY.
# Incoming/outgoing Vobiz codec is mu-law 8000 Hz; max frame payload 64 KiB.

# Set to 1 only after explicit operator verification of real callback signatures.
# Match the app gate; 0 disables every Vobiz phone handshake. Legacy Exotel
# also requires an internal plan and the separate phone kill switch.
VOBIZ_CALLBACK_SIGNATURES_VERIFIED=0

# Local bridge port; Render injects PORT automatically.
PORT=3001

# Closed alpha AI: server-only, separate keys/projects for development, alpha and production.
# New invite-created tenants use this key. Existing tenants retain their own keys.
AI_ENVIRONMENT=development
PLATFORM_GEMINI_API_KEY=
ALPHA_AI_DAILY_REQUEST_LIMIT=20
# Conservative budget estimates in paise, not actual Gemini/carrier prices.
AI_VOICE_ESTIMATE_MINOR_PER_MINUTE=100
# REQUIRED before phone admission: approved worst-case provider exposure per minute.
PROVIDER_VOICE_RESERVE_MINOR_PER_MINUTE=
PRICING_VERSION=alpha-v1
PLATFORM_BROWSER_VOICE_ENABLED=1
# Independent kill switches. They do not attest provider readiness.
PLATFORM_NEW_PHONE_CALLS_ENABLED=0
PLATFORM_NUMBER_PURCHASE_ENABLED=0
