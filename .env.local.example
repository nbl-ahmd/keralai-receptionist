# ─────────────────────────────────────────────────────────────────────────────
# KeralAI Receptionist — environment template
#
# Copy to .env.local for development, and set the same keys in your hosting
# provider for production. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# REQUIRED. Pooled connection string from the Neon console.
# Format: postgresql://<role>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: max clients per serverless instance (default 5).
# PG_POOL_MAX=5

# ─── Gemini (server-side) ────────────────────────────────────────────────────
# REQUIRED for the phone bridge, knowledge embeddings, and the knowledge chat.
# Get one at https://aistudio.google.com/app/apikey
# NEVER expose this to the browser.
GEMINI_API_KEY=your_server_side_gemini_key_here

# Optional: override the text model used for chat/file extraction.
# GENAI_MODEL=gemini-flash-lite-latest

# ─── Browser relay ───────────────────────────────────────────────────────────
# The browser demo uses the server-side WebSocket relay. No Gemini key belongs
# in NEXT_PUBLIC_* variables.
# Optional production origin check for /ws/browser:
# PUBLIC_APP_ORIGIN=https://app.example.com
# Optional browser-demo abuse controls:
# BROWSER_MAX_SESSIONS_PER_IP=3
# BROWSER_SESSION_TTL_MS=900000

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=production

# ─── Phone bridge (Exotel) ───────────────────────────────────────────────────
# Exotel sends 8 kHz by default. Set to 16000 only if your applet is configured
# with ?sample-rate=16000.
# EXOTEL_SAMPLE_RATE=8000

# Maya voice persona for phone calls (default: Aoede).
# Available: Aoede, Kore, Zephyr, Puck, Fenrir, Charon
# MAYA_VOICE=Aoede

# Speaking style hints injected into the system instruction.
# MAYA_PITCH=Normal
# MAYA_SPEED=Normal

# ─── Booking rules ───────────────────────────────────────────────────────────
# Business hours used to validate and offer slots (24h "HH:MM").
# BOOKING_OPEN_TIME=09:00
# BOOKING_CLOSE_TIME=18:00
# BOOKING_SLOT_MINUTES=30
# BOOKING_OPEN_DAYS=1,2,3,4,5,6   # 0=Sunday … 6=Saturday
# BOOKING_HORIZON_DAYS=30

# ─── CRM integration ─────────────────────────────────────────────────────────
# CRM_PROVIDER=none             # none | webhook
# CRM_WEBHOOK_URL=https://your-crm-or-automation-endpoint.example/hooks/keralai
# CRM_WEBHOOK_SECRET=shared_secret_sent_as_X-KeralAI-Signature
#
# The webhook receives a JSON body:
# {
#   "event": "contact.call_completed" | "contact.appointment_booked",
#   "contact": { "id", "name", "phone", "email", "company", "source" },
#   "call": { "callSid", "intent", "outcome", "summary", "durationSec", "startedAt" } | null,
#   "appointment": { "date", "time", "reason", "status" } | null,
#   "company": { "name", "industry", "phone" } | null,
#   "sentAt": "ISO-8601"
# }
# Respond 2xx with an optional {"id": "..."} to store the external CRM id.
