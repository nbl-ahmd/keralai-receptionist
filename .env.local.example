# ─────────────────────────────────────────────────────────────────────────────
# KeralAI Receptionist — Next.js environment template
#
# Copy to .env.local for development, and set the same keys in your hosting
# provider (e.g. Vercel) for production. NEVER commit real secrets.
#
# The standalone bridge (Render) has its own template: bridge/.env.example.
# Some values are SHARED between the two services — see docs/deployment.md.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# REQUIRED. Pooled connection string from the Neon console.
# Format: postgresql://<role>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# REQUIRED. Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace_with_a_random_32_byte_base64_secret

# REQUIRED in production. The public origin of this Next.js app. Used as the
# auth base URL and as a trusted origin. Comma-separated origins are allowed
# via PUBLIC_APP_ORIGIN (shared with the bridge).
# BETTER_AUTH_URL=https://keralai-receptionist.vercel.app

# ─── Bridge authentication (SHARED with the bridge) ──────────────────────────
# REQUIRED. Signs the short-lived browser-voice bridge token. MUST be identical
# on the Next.js app and the bridge service, or browser voice fails.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BRIDGE_AUTH_SECRET=replace_with_a_random_32_byte_base64_secret

# ─── Tenant secret encryption (SHARED with the bridge) ───────────────────────
# REQUIRED. AES-256-GCM key that encrypts tenant provider credentials at rest.
# MUST be identical on the Next.js app and the bridge service.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_SECRETS_ENCRYPTION_KEY=replace_with_a_random_32_byte_base64_key

# ─── Legacy tenant claim (optional) ──────────────────────────────────────────
# Email address allowed to claim the pre-multitenant "legacy" workspace. The
# account with this exact email can absorb the migrated single-tenant data from
# the dashboard — but only when it also presents LEGACY_TENANT_CLAIM_TOKEN.
# Users are never granted the legacy workspace implicitly at signup.
# Leave LEGACY_TENANT_CLAIM_EMAIL unset to disable claiming entirely.
# LEGACY_TENANT_CLAIM_EMAIL=owner@example.com

# REQUIRED to enable claiming. A server-only secret the owner types into
# Settings → Providers → Legacy data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LEGACY_TENANT_CLAIM_TOKEN=replace_with_a_random_secret

# Optional extra hardening (V1 does not require email verification):
# reject claiming from accounts whose email is not verified.
# LEGACY_TENANT_CLAIM_REQUIRE_VERIFIED_EMAIL=0

# ─── Gemini (per-tenant credentials) ─────────────────────────────────────────
# There is NO global Gemini API key. Each tenant stores its own encrypted key
# in Dashboard → Settings → Providers. The variables below only override the
# platform default model names when a tenant has not chosen one.
# GENAI_MODEL=gemini-flash-lite-latest      # text / chat / file extraction
# GEMINI_MODEL=gemini-3.8-live              # Gemini Live (voice)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2 # knowledge embeddings

# ─── Browser voice relay ─────────────────────────────────────────────────────
# The dashboard requests a short-lived signed bridge token from
# /api/voice/token, then connects to the bridge at /ws/browser?token=...
#
# REQUIRED in production: the bridge's public WebSocket origin. The dashboard
# (Vercel) and the bridge (Render) are different hosts, so the client cannot
# derive this from window.location. Use wss:// for https dashboards.
# NEXT_PUBLIC_BRIDGE_WS_URL=wss://keralai-bridge.onrender.com
#
# If unset, the client falls back to the page origin (only works when the
# bridge and dashboard are served from the same host, e.g. some local setups).
# PUBLIC_BRIDGE_WS_URL (server-side) is accepted as an alias.

# ─── Site metadata ───────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap, and metadataBase.
# NEXT_PUBLIC_SITE_URL=https://keralai-receptionist.vercel.app

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=production

# ─── Phone bridge (Exotel) ───────────────────────────────────────────────────
# Fallback sample rate only; the bridge prefers the rate Exotel reports per call.
# EXOTEL_SAMPLE_RATE=8000

# Voice / pitch / speed / opening greeting are managed per tenant in the
# dashboard (stored in `company_profile`). Values below are fallback defaults.
# ASSISTANT_VOICE=Aoede   # Aoede | Kore | Zephyr | Puck | Fenrir | Charon
# ASSISTANT_PITCH=Normal
# ASSISTANT_SPEED=Normal
# ASSISTANT_GREETING=0

# Live transcription, vocabulary, and voice-activity tuning.
# Tenant names from the company profile are added to the vocabulary automatically.
# GEMINI_TRANSCRIPTION_LANGUAGES=ml-IN,en-IN
# GEMINI_TRANSCRIPTION_CUSTOM_VOCABULARY=KeralAI,Kerala,Kochi
# GEMINI_TRANSCRIPTION_MODE=VERBATIM      # VERBATIM | SMART
# GEMINI_END_SILENCE_MS=350               # end-of-speech silence (lower = faster turns)
# GEMINI_PREFIX_PADDING_MS=200
# END_CALL_GRACE_MS=900                   # delay before hang-up after the caller is done

# ─── Booking rules ───────────────────────────────────────────────────────────
# Business hours used to validate and offer slots (24h "HH:MM").
# BOOKING_OPEN_TIME=09:00
# BOOKING_CLOSE_TIME=18:00
# BOOKING_SLOT_MINUTES=30
# BOOKING_OPEN_DAYS=1,2,3,4,5,6   # 0=Sunday … 6=Saturday
# BOOKING_HORIZON_DAYS=30

# ─── CRM integration ─────────────────────────────────────────────────────────
# CRM configuration is now PER TENANT, stored in tenant settings/secrets and
# managed from Dashboard → Settings → Providers. These env values are legacy
# defaults and are no longer read for tenant traffic.